{
  "name": "helpme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HelpMe AI-first life admin web app shell.",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit",
    "db:migrate": "node server/db/migrate.mjs",
    "db:seed": "node server/db/seed.mjs",
    "db:reset": "node server/db/seed.mjs --reset",
    "dev": "node server.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/middie": "^9.0.3",
    "@fastify/static": "^9.1.3",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.2",
    "lucide-react": "^1.17.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^8.0.16",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
